# Kopyala: cp .env.example .env   (.env ASLA git'e gönderilmez)
# API key: withdrawal izni KAPALI, IP restriction AÇIK olmalı.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# prod | demo | testnet  (Spot: demo-api.binance.com / testnet.binance.vision)
BINANCE_ENVIRONMENT=prod

# backtest | paper | live   (varsayılan paper; Faz 1'de emir kodu zaten YOK)
TRADING_MODE=paper
# LIVE için ayrıca tam olarak şu cümle gerekir (Faz 2+ ve açık onayınla):
LIVE_TRADING_CONFIRM=
